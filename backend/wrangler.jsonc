{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contacts-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contacts-sync",
      "database_id": "0c0caaa4-769f-4ea1-a06a-ba519a1df531"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "contact-sync-backups"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
}
}