<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application
        android:name=".ContactApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContactSync">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="dev.mathankumar.android.contactsync.account.ContactAuthenticatorService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">

            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>

            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />

        </service>


        <service
            android:name="dev.mathankumar.android.contactsync.sync.ContactSyncService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/contacts"
            android:permission="android.permission.BIND_SYNC_ADAPTER">

            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>

            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />

        </service>

        <service
            android:name="dev.mathankumar.android.contactsync.sync.DummySyncService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/sync_status"
            android:permission="android.permission.BIND_SYNC_ADAPTER">

            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>

            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dummy_syncadapter" />

        </service>

        <provider
            android:name="dev.mathankumar.android.contactsync.sync.DummyProvider"
            android:authorities="dev.mathankumar.android.contactsync.dummy"
            android:exported="false"
            android:label="@string/sync_status"
            android:syncable="true" />


    </application>

</manifest>